# Copy to .env.local. Everything works with mock data when these are unset.

# Set to 1 to force every API route onto mock data (use for the live demo if a real API is flaky).
DEMO_MODE=

# Geocoding provider: mock | google | mapbox | nominatim (only mock is implemented)
GEOCODING_PROVIDER=mock
GEOCODING_API_KEY=

# Forum storage: mock | supabase (only mock is implemented; mock resets on every deploy)
FORUM_STORE=mock
