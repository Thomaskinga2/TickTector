# Copy to .env.local. Everything works when these are unset: live Mass. DPH, NWS and Census data, no keys.

# Set to 1 to keep every API route offline (bundled DPH copy, no forecast, nearest-town lookup) for a demo on bad Wi-Fi.
DEMO_MODE=

# Geocoding provider: census (US Census Geocoder, default) | mock (nearest town, offline) | google | mapbox | nominatim (not implemented)
GEOCODING_PROVIDER=census
GEOCODING_API_KEY=

# Forum storage: mock | supabase (only mock is implemented; mock resets on every deploy)
FORUM_STORE=mock

# Forum moderators send this in an "x-mod-token" header to list reports and hide posts. Unset = moderation off.
FORUM_MOD_TOKEN=
