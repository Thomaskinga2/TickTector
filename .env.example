# Copy to .env.local. Everything works with no keys when these are unset.

# Set to 1 to force every API route onto mock data (use for the live demo if a real API is flaky).
DEMO_MODE=

# Geocoding provider: local (default: bundled MassGIS towns, no key) | mock | google | mapbox | nominatim (not implemented)
GEOCODING_PROVIDER=local
GEOCODING_API_KEY=

# Forum storage: mock | supabase (only mock is implemented; mock resets on every deploy)
FORUM_STORE=mock

# Forum moderators send this in an "x-mod-token" header to list reports and hide posts. Unset = moderation off.
FORUM_MOD_TOKEN=
